  if (ch.belt) { tstroke(ctx, [-.85, -3.05], [-.55, -2.9], [-.25, -2.55], .03, fc); tstroke(ctx, [.85, -3.0], [.55, -2.85], [.3, -2.5], .03, fc); }
  if (ch.belt) cel(ctx, p => { p.moveTo(-2, -3.62); p.quadraticCurveTo(0, -3.42, 2, -3.62); p.lineTo(2, -3.36); p.quadraticCurveTo(0, -3.16, -2, -3.36); p.closePath(); }, ch.belt, { sd: .05, rd: 0, lw: LW_I });
