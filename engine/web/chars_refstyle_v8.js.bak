// chars.js — house puppet v4 (rebuilt from the critic's measured fixes)
//  • egg head 1.35× taller than wide, widest at 60% height, full jowls, no ears, no nose (tiny bump in 3/4)
//  • 3/4 view by default: feature cluster shifted toward the facing side, far eye smaller, head cocked
//  • head = 30% of figure height (≈3.3 heads tall), pear/bean torso, sloped shoulders
//  • lidded "smug" eyes: thick upper-lid stroke over a half-disc pupil; wedge or dash brows
//  • near-black beards with a handlebar moustache and a skin lip patch
//  • one-piece noodle arms, big mitten hands (3–4 sausage fingers), fists by default
//  • warm brown-black brush line (silhouette ≈2.25% of head width, interior ≈1.3%), tapered open strokes
//  • flat cel shading: base + one hard shadow shape (away from the light) + a pale rim band on the lit edge
// Units: head half-width = 1. Origin at the feet, y negative = up.
'use strict';
const LINE = '#2A2220';
let HY = -7.65, HHH = 1.35, HEAD_TOP = -9.0; const CHIN = -6.3;   // head centre / half-height / top (set per character)
const LW_S = .055, LW_I = .032;                // silhouette / interior stroke widths (units)

// ---------- primitives ----------
function strokePath(ctx, pathFn, w, col = LINE) { ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.strokeStyle = col; ctx.lineWidth = w; ctx.beginPath(); pathFn(ctx); ctx.stroke(); }
// tapered brush stroke along a quadratic curve p0 → c → p1
function tstroke(ctx, p0, c, p1, w, col = LINE, cap = .18) {
  const pts = [], n = 16; for (let i = 0; i <= n; i++) { const u = i / n; pts.push([(1 - u) * (1 - u) * p0[0] + 2 * (1 - u) * u * c[0] + u * u * p1[0], (1 - u) * (1 - u) * p0[1] + 2 * (1 - u) * u * c[1] + u * u * p1[1], u]); }
  const L = [], R = [];
  for (let i = 0; i <= n; i++) { const a = pts[Math.max(0, i - 1)], b = pts[Math.min(n, i + 1)]; let dx = b[0] - a[0], dy = b[1] - a[1]; const d = Math.hypot(dx, dy) || 1; dx /= d; dy /= d;
    const u = pts[i][2]; const ww = w * (cap + (1 - cap) * Math.pow(Math.sin(Math.PI * u), .55)) / 2; L.push([pts[i][0] - dy * ww, pts[i][1] + dx * ww]); R.push([pts[i][0] + dy * ww, pts[i][1] - dx * ww]); }
  ctx.beginPath(); L.forEach((p, i) => i ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1])); for (let i = R.length - 1; i >= 0; i--) ctx.lineTo(R[i][0], R[i][1]); ctx.closePath(); ctx.fillStyle = col; ctx.fill();
}
// path recorder → polylines (so outlines can be drawn with varying width)
function flatten(pathFn) {
