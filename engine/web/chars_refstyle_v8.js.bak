// ---------- hair (clumped masses with pointed flicks) ----------
function clumpPath(p, pts) { p.moveTo(pts[0][0], pts[0][1]); for (let i = 1; i < pts.length; i++) { const a = pts[i - 1], b = pts[i]; p.quadraticCurveTo((a[0] + b[0]) / 2 + (b[1] - a[1]) * .25, (a[1] + b[1]) / 2 - (b[0] - a[0]) * .25, b[0], b[1]); } p.closePath(); }
