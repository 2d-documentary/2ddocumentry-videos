const LIGHT_AWAY = [.55, .83];   // outward normals pointing this way (lower-right) get the heavy line
function brushOutline(ctx, pathFn, w, col = LINE) {
  ctx.fillStyle = col;
  for (const sp of flatten(pathFn)) {
    const P = sp.pts.filter((p, i, a) => i === 0 || Math.hypot(p[0] - a[i - 1][0], p[1] - a[i - 1][1]) > 1e-4); const n = P.length; if (n < 2) continue;
    let area = 0; for (let i = 0; i < n; i++) { const a = P[i], b = P[(i + 1) % n]; area += a[0] * b[1] - b[0] * a[1]; } const orient = area > 0 ? 1 : -1;
    const W = [], N = [];
    for (let i = 0; i < n; i++) {
      const a = P[(i - 1 + n) % n], b = P[(i + 1) % n]; const prevOk = sp.closed || i > 0, nextOk = sp.closed || i < n - 1;
      const A = prevOk ? a : P[i], B = nextOk ? b : P[i]; let tx = B[0] - A[0], ty = B[1] - A[1]; const tl = Math.hypot(tx, ty) || 1; tx /= tl; ty /= tl;
      const nx = ty * orient, ny = -tx * orient; N.push([nx, ny]);
      let k = .62 + .62 * Math.max(0, nx * LIGHT_AWAY[0] + ny * LIGHT_AWAY[1]);                 // swell on the shadow side
      // taper at sharp corners and open ends
      if (prevOk && nextOk) { const ux = P[i][0] - a[0], uy = P[i][1] - a[1], vx = b[0] - P[i][0], vy = b[1] - P[i][1]; const c = (ux * vx + uy * vy) / ((Math.hypot(ux, uy) * Math.hypot(vx, vy)) || 1); if (c < .35) k *= .55 + .45 * Math.max(0, c + .2); }
      if (!sp.closed) { const e = Math.min(i, n - 1 - i) / Math.max(1, Math.min(4, (n - 1) / 2)); k *= .35 + .65 * Math.min(1, e); }
      W.push(w * k);
    }
    // smooth widths a little
    const Ws = W.map((v, i) => (W[(i - 1 + n) % n] + 2 * v + W[(i + 1) % n]) / 4);
    const L = [], Rr = []; for (let i = 0; i < n; i++) { L.push([P[i][0] + N[i][0] * Ws[i] / 2, P[i][1] + N[i][1] * Ws[i] / 2]); Rr.push([P[i][0] - N[i][0] * Ws[i] / 2, P[i][1] - N[i][1] * Ws[i] / 2]); }
    ctx.beginPath();
    if (sp.closed) { L.forEach((q, i) => i ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1])); ctx.closePath(); Rr.forEach((q, i) => i ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1])); ctx.closePath(); ctx.fill('evenodd'); }
    else { L.forEach((q, i) => i ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1])); for (let i = n - 1; i >= 0; i--) ctx.lineTo(Rr[i][0], Rr[i][1]); ctx.closePath(); ctx.fill(); }
  }
}
// flat cel shading: base, hard shadow band (lower-right, away from light), pale rim band (upper-left), then outline
function cel(ctx, pathFn, base, o = {}) {
  const sd = o.sd ?? .32, rd = o.rd ?? .09;
  ctx.save(); ctx.beginPath(); pathFn(ctx); ctx.clip();
  { const g = ctx.createLinearGradient(-1.5, -1, 1.5, 1); g.addColorStop(0, shade(base, 1.04)); g.addColorStop(1, shade(base, .96)); ctx.fillStyle = g; ctx.fillRect(-40, -40, 80, 80); }
  if (sd > 0) { ctx.save(); ctx.translate(-sd, -sd * (o.sv ?? .35)); ctx.beginPath(); ctx.rect(-80, -80, 160, 160); pathFn(ctx); ctx.fillStyle = o.shadow || shade(base, .82); ctx.fill('evenodd'); ctx.restore(); }
  if (rd > 0) { ctx.save(); ctx.translate(rd, rd * .9); ctx.beginPath(); ctx.rect(-80, -80, 160, 160); pathFn(ctx); ctx.fillStyle = o.rim || mix(base, '#FFFFFF', .32); ctx.globalAlpha = .9; ctx.fill('evenodd'); ctx.restore(); }
  if (o.after) o.after(ctx);
  ctx.restore();
