// ---------- head ----------
// half-width profile w(v), v = 0 top … 1 chin; widest at v = .62, crown ≈ .75 of max at v = .2
let HEAD = { top: -9.0, hh: 1.35, turn: 0 };
function setHead(ch, turn) { const hh = ch.headHH || 1.35; HEAD = { top: CHIN - 2 * hh, hh, turn }; HHH = hh; HY = CHIN - hh; HEAD_TOP = CHIN - 2 * hh; }
function headW(v, side) {
  const pk = .62; const u = v < pk ? (pk - v) / pk : (v - pk) / (1 - pk);
  let w = Math.pow(Math.max(0, 1 - u * u), v < pk ? .5 : .42);
  const t = HEAD.turn, far = side === -Math.sign(t || 1);
  if (Math.abs(t) > .2) { if (far && v > .4 && v < .85) w *= 1 + .05 * Math.sin((v - .4) / .45 * Math.PI); if (!far && v > .15 && v < .65) w *= 1 - .03 * Math.sin((v - .15) / .5 * Math.PI); }
  return w;
}
function headPath(c) {
  const n = 30, pts = [];
  for (let i = 0; i <= n; i++) { const v = i / n; pts.push([headW(v, 1), HEAD.top + v * 2 * HEAD.hh]); }
  for (let i = n - 1; i >= 1; i--) { const v = i / n; pts.push([-headW(v, -1), HEAD.top + v * 2 * HEAD.hh]); }
  c.moveTo((pts[0][0] + pts[1][0]) / 2, (pts[0][1] + pts[1][1]) / 2);
  for (let i = 1; i < pts.length; i++) { const a = pts[i], b = pts[(i + 1) % pts.length]; c.quadraticCurveTo(a[0], a[1], (a[0] + b[0]) / 2, (a[1] + b[1]) / 2); }
  c.closePath();
}
const hy = v => HEAD.top + v * 2 * HEAD.hh;   // y at fraction v of head height

// ---------- face (3/4) ----------
function faceGeom(turn) {
