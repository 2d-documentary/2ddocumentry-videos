    cel(ctx, p => p.roundRect(.1, -3.5, .09, .42, .03), '#8E949C', { sd: .02, rd: 0, lw: LW_I * .8 }); cel(ctx, p => p.roundRect(-.22, -3.4, .12, .34, .04), '#7E5634', { sd: .03, rd: 0, lw: LW_I * .8 });
