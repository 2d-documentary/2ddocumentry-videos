    if (type !== 'thumb') cel(ctx, p => { p.moveTo(.05, -.3); p.quadraticCurveTo(.3, -.38, .42, -.22); p.quadraticCurveTo(.44, -.12, .32, -.12); p.quadraticCurveTo(.2, -.18, .06, -.14); p.closePath(); }, M, { sd: .03, rd: 0, lw: LW_I });
