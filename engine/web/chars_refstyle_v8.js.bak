  const w = .13;
  switch (kind) {
    case 'open': case 'openS': { const ww = kind === 'open' ? .12 : .09, hh = kind === 'open' ? .15 : .09;
      ctx.beginPath(); ctx.moveTo(mx - ww, my - .02); ctx.quadraticCurveTo(mx, my - .05, mx + ww, my - .02); ctx.quadraticCurveTo(mx + ww, my + hh, mx, my + hh); ctx.quadraticCurveTo(mx - ww, my + hh, mx - ww, my - .02); ctx.closePath();
      ctx.fillStyle = '#3A2026'; ctx.fill(); ctx.save(); ctx.clip(); ctx.fillStyle = '#B4505C'; ctx.beginPath(); ctx.ellipse(mx, my + hh, ww * .7, hh * .45, 0, 0, 7); ctx.fill(); ctx.restore(); ctx.lineWidth = LW_I; ctx.strokeStyle = LINE; ctx.stroke(); break; }
    case 'smile': tstroke(ctx, [mx - w, my - .02], [mx, my + .07], [mx + w, my - .02], .045); break;
    case 'smirk': tstroke(ctx, [mx - w * .8, my + .02], [mx + sg * .02, my + .04], [mx + sg * w * 1.1, my - .06], .045); break;
    case 'grin': ctx.beginPath(); ctx.moveTo(mx - .17, my - .04); ctx.quadraticCurveTo(mx, my - .01, mx + .17, my - .04); ctx.quadraticCurveTo(mx + .13, my + .14, mx, my + .14); ctx.quadraticCurveTo(mx - .13, my + .14, mx - .17, my - .04); ctx.closePath(); ctx.fillStyle = '#F2F0EE'; ctx.fill(); ctx.lineWidth = LW_I; ctx.strokeStyle = LINE; ctx.stroke(); break;
