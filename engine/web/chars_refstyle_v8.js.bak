function drawBrow(ctx, kind, x, y, k, sg, side) {
  const inward = -sg * side; // direction toward the nose along x
  switch (kind) {
    case 'angry': { const xo = x - inward * .26 * k, xi = x + inward * .16 * k; ctx.beginPath(); ctx.moveTo(xo, y - .3); ctx.quadraticCurveTo(x, y - .28, xi, y - .16); ctx.lineTo(xi - inward * .01, y - .08); ctx.quadraticCurveTo(x, y - .2, xo, y - .3); ctx.closePath(); ctx.fillStyle = LINE; ctx.fill(); break; }
    case 'worried': tstroke(ctx, [x - inward * .18 * k, y - .12], [x, y - .2], [x + inward * .16 * k, y - .3], .07 * k); break;
    case 'shock': tstroke(ctx, [x - .14 * k, y - .36], [x, y - .42], [x + .14 * k, y - .36], .06 * k); break;
    case 'squint': if (side > 0) tstroke(ctx, [x - .16 * k, y - .14], [x, y - .17], [x + .16 * k, y - .12], .08 * k); else tstroke(ctx, [x - .14 * k, y - .34], [x, y - .42], [x + .16 * k, y - .38], .07 * k); break;
