    p.moveTo(pts[0][0], pts[0][1]); p.quadraticCurveTo(-1.28, hy(.42), P2[0][0], P2[0][1]);
    for (let i = 1; i < P2.length; i++) { const a = P2[i - 1], b = P2[i]; const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2, nx = -(b[1] - a[1]), ny = b[0] - a[0]; p.quadraticCurveTo(mx + nx * .14, my + ny * .14, b[0], b[1]); }
