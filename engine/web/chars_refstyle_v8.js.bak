}
function drawEye(ctx, kind, x, y, k, sg, side /* +1 near, -1 far */, blink, t) {
  const W = .3 * k, inward = -sg * side; // positive inward = toward the nose (for the near eye that's -sg)
  const lidStroke = (droop = .07, tw = .115) => { const dn = (px) => ((px - x) * inward > 0 ? droop : -droop * .3); tstroke(ctx, [x - W, y - .03 + dn(x - W)], [x, y - .08], [x + W, y - .03 + dn(x + W)], tw * k, LINE, .55); };
  const halfPupil = (r = .105, cut = .0) => { ctx.save(); ctx.beginPath(); ctx.rect(x - .3, y + cut, .6, .4); ctx.clip(); ctx.beginPath(); ctx.ellipse(x + sg * .02, y + cut, r * k, r * 1.15 * k, 0, 0, 7); ctx.fillStyle = LINE; ctx.fill(); ctx.restore(); };
  if (blink && kind !== 'shock') kind = 'closed';
  switch (kind) {
    case 'closed': tstroke(ctx, [x - W, y], [x, y + .08], [x + W, y], .07 * k); break;
    case 'proud': tstroke(ctx, [x - W, y + .05], [x, y - .07], [x + W, y + .05], .07 * k); break;
    case 'open': ctx.beginPath(); ctx.ellipse(x + sg * .02, y + .02, .075 * k, .1 * k, 0, 0, 7); ctx.fillStyle = LINE; ctx.fill(); tstroke(ctx, [x - W * .8, y - .1], [x, y - .15], [x + W * .8, y - .1], .05 * k); break;
    case 'shock': ctx.beginPath(); ctx.ellipse(x, y, .14 * k, .17 * k, 0, 0, 7); ctx.fillStyle = '#F4F2F0'; ctx.fill(); ctx.lineWidth = LW_I; ctx.strokeStyle = LINE; ctx.stroke(); ctx.beginPath(); ctx.arc(x + sg * .02, y + .01, .035 * k, 0, 7); ctx.fillStyle = LINE; ctx.fill(); break;
    case 'angry': halfPupil(.08, .02); lidStroke(.1, .1); break;
    case 'worried': ctx.beginPath(); ctx.ellipse(x, y + .02, .07 * k, .09 * k, 0, 0, 7); ctx.fillStyle = LINE; ctx.fill(); break;
    case 'squint': if (side > 0) tstroke(ctx, [x - W, y], [x, y - .02], [x + W, y + .01], .08 * k); else { ctx.beginPath(); ctx.ellipse(x, y + .01, .07 * k, .09 * k, 0, 0, 7); ctx.fillStyle = LINE; ctx.fill(); } break;
