  const n = 18, pts = []; for (let i = 0; i <= n; i++) { const u = i / n; pts.push([(1 - u) * (1 - u) * s[0] + 2 * (1 - u) * u * c[0] + u * u * w[0], (1 - u) * (1 - u) * s[1] + 2 * (1 - u) * u * c[1] + u * u * w[1], u]); }
  const L = [], R = []; for (let i = 0; i <= n; i++) { const a = pts[Math.max(0, i - 1)], b = pts[Math.min(n, i + 1)]; let dx = b[0] - a[0], dy = b[1] - a[1]; const dd = Math.hypot(dx, dy) || 1; dx /= dd; dy /= dd; const ww = lerp(w1, w2, pts[i][2]); L.push([pts[i][0] - dy * ww, pts[i][1] + dx * ww]); R.push([pts[i][0] + dy * ww, pts[i][1] - dx * ww]); }
