// ---------- beard / moustache ----------
function drawBeard(ctx, ch, f) {
  if (!ch.beard) return;
  const c = ch.beardColor || '#1E1713', cx = f.cx, sg = f.sg;
  if (ch.beard === 'full' || ch.beard === 'short') {
    const len = ch.beard === 'full' ? .5 : .18;
    const R = headW(.78, 1) + .1, L = headW(.78, -1) + .1, e = hy(.6), m = hy(.66);
    const path = k => {
      k.moveTo(-headW(.6, -1) - .02, e);
      k.bezierCurveTo(-.6, e + .05, cx - .35, m, cx, m);
      k.bezierCurveTo(cx + .35, m, .6, e + .05, headW(.6, 1) + .02, e);
      k.bezierCurveTo(R + .12, hy(.75), R + .06, CHIN + .05, .72, CHIN + len * .6);
      k.quadraticCurveTo(.6, CHIN + len * .98, .34, CHIN + len * .85);
      k.quadraticCurveTo(cx + sg * .18, CHIN + len + .12, cx + sg * .05, CHIN + len + .18);
      k.quadraticCurveTo(cx - .12, CHIN + len + .04, -.34, CHIN + len * .86);
      k.quadraticCurveTo(-.6, CHIN + len * .98, -.72, CHIN + len * .6);
      k.bezierCurveTo(-L - .06, CHIN + .05, -L - .12, hy(.75), -headW(.6, -1) - .02, e); k.closePath(); };
    cel(ctx, path, c, { sd: .5, sv: .15, rd: 0, shadow: shade(c, .7), after: k => {
      k.save(); k.filter = `blur(${Math.max(1, CUR_S * .05)}px)`; k.beginPath(); k.rect(-5, -12, 10, 14); k.translate(.38, -.05); path(k); k.fillStyle = mix(c, '#ffffff', .07); k.fill('evenodd'); k.restore(); } });
  }
  // handlebar moustache: near-black like the beard, separated by a thin light edge; tips curl up below the eyes
  const bearded = ch.beard === 'full' || ch.beard === 'short';
  const my = bearded ? hy(.69) : hy(.6), mw = .52, mc = bearded ? '#3A302A' : c;
  { const x0 = cx + sg * .04, kR = sg > 0 ? 1 : f.farK, kL = sg > 0 ? f.farK : 1;
    cel(ctx, p => {
      p.moveTo(x0, my - .02);                                                              // centre dip
      p.bezierCurveTo(x0 + .25 * kR, my - .16, x0 + mw * .75 * kR, my - .02, x0 + (mw + .08) * kR, my - .2);   // right wing up to the tip
      p.quadraticCurveTo(x0 + (mw + .12) * kR, my - .05, x0 + (mw - .04) * kR, my + .07);
      p.bezierCurveTo(x0 + mw * .6 * kR, my + .22, x0 + .2 * kR, my + .2, x0, my + .17);      // underside back to centre
      p.bezierCurveTo(x0 - .2 * kL, my + .2, x0 - mw * .6 * kL, my + .22, x0 - (mw - .04) * kL, my + .07);
      p.quadraticCurveTo(x0 - (mw + .12) * kL, my - .05, x0 - (mw + .06) * kL, my - .17);
      p.bezierCurveTo(x0 - mw * .75 * kL, my - .02, x0 - .25 * kL, my - .16, x0, my - .02); p.closePath(); }, mc, { sd: .05, rd: .035, rim: mix(mc, '#ffffff', .3), lw: LW_I * 1.2 });
  }
  if (ch.beard === 'full' || ch.beard === 'short') {
    // skin lip/chin patch: rounded inverted bean with a centre notch (≈0.22 HW wide)
    const lp = [cx + sg * .05, my + .17];
    cel(ctx, k => { k.moveTo(lp[0] - .22, lp[1]); k.quadraticCurveTo(lp[0], lp[1] - .05, lp[0] + .22, lp[1]); k.quadraticCurveTo(lp[0] + .25, lp[1] + .22, lp[0] + .06, lp[1] + .27); k.quadraticCurveTo(lp[0], lp[1] + .23, lp[0] - .06, lp[1] + .27); k.quadraticCurveTo(lp[0] - .25, lp[1] + .22, lp[0] - .22, lp[1]); k.closePath(); }, ch.skin || SKIN4, { sd: .07, rd: 0, lw: LW_I });
