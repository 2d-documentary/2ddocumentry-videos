  c = [lerp((g.s[0] + g.w[0]) / 2, c[0], .6) + side * .08, lerp((g.s[1] + g.w[1]) / 2, c[1], .6)];   // soft elbow, slightly away from the body
  const sleeve = ch.sleeve || ch.robe;
  const q = (u) => [(1 - u) * (1 - u) * g.s[0] + 2 * (1 - u) * u * c[0] + u * u * g.w[0], (1 - u) * (1 - u) * g.s[1] + 2 * (1 - u) * u * c[1] + u * u * g.w[1]];
  const hemU = ch.rolled ? .55 : .93;
  // whole arm in skin (forearm) then the sleeve over the upper part
  if (ch.rolled) noodle(ctx, g.s, c, g.w, .4, .28, ch.skin || SKIN4, { sd: .1 });
  const h = q(hemU), cm = [lerp(g.s[0], c[0], hemU), lerp(g.s[1], c[1], hemU)];
  noodle(ctx, g.s, [lerp(g.s[0], cm[0], 1), lerp(g.s[1], cm[1], 1)], h, .42, ch.rolled ? .36 : .31, sleeve, { sd: .12 });
  // sleeve hem: one curved tapered line across the arm
  const ang = Math.atan2(g.w[1] - h[1], g.w[0] - h[0]); ctx.save(); ctx.translate(h[0], h[1]); ctx.rotate(ang); tstroke(ctx, [-.02, -.36], [.07, 0], [-.02, .36], .045); ctx.restore();
  // elbow fold
  { const m = q(.42), m2 = q(.5), ang2 = Math.atan2(m2[1] - m[1], m2[0] - m[0]), nx = -Math.sin(ang2), ny = Math.cos(ang2);
    tstroke(ctx, [m[0] + nx * .32, m[1] + ny * .32], [m[0] + Math.cos(ang2) * .14, m[1] + Math.sin(ang2) * .14], [m[0] - nx * .2, m[1] - ny * .2], .03, shade(sleeve, .5)); }
  if (A.prop === 'mallet') { ctx.save(); ctx.translate(g.w[0], g.w[1]); ctx.rotate(g.dir); cel(ctx, p => p.roundRect(.25, -.07, .13, 1.4, .05), '#7E5634', { sd: .04, rd: .01, lw: LW_I * 1.2 }); cel(ctx, p => p.roundRect(.02, -.75, .6, .5, .08), '#8F8579', { sd: .1, rd: .03, lw: LW_I * 1.2 }); ctx.restore(); }
  if (A.hand !== 'none') { ctx.save(); ctx.translate(g.w[0], g.w[1]); ctx.rotate(g.dir + (A.handRot || 0) * Math.PI / 180 * side); drawMitten(ctx, A.hand, side < 0); ctx.restore(); }
  return g;
}
/** draw a character.
 * ch: cast sheet. o: {x, y, s (px per unit), flip, turn (-1..1, + faces right), tilt (deg), eyes, brows, mouth, talk, armL, armR, sweat, lean, t, bob, blink} */
let CUR_S = 60;
function drawCharacter(ctx, ch, o) {
  const t = o.t || 0, s = o.s || 60; CUR_S = s;
  const turn = o.turn ?? (o.flip ? -.45 : .45);
  setHead(ch, turn); const f = faceGeom(turn);
  ctx.save(); ctx.translate(o.x, o.y + (o.bob ? Math.sin(t * Math.PI * 2 / 2.4) * o.bob : 0)); ctx.scale(s, s); ctx.rotate(o.lean || 0);
  if (o.shadow !== false) { ctx.save(); ctx.globalAlpha = .3; ctx.fillStyle = '#1a1424'; ctx.filter = `blur(${Math.max(1, s * .12)}px)`; ctx.beginPath(); ctx.ellipse(.6, .05, 1.9, .3, 0, 0, 7); ctx.fill(); ctx.restore(); }
  const br = 1 + Math.sin(t * Math.PI * 2 / 2.6) * .005; ctx.scale(1, br);
  const armL = o.armL || 'down', armR = o.armR || 'down';
  const back = a => (typeof a === 'string' ? ARMS[a] : a).back;
  if (back(armL)) drawArm(ctx, ch, -1, armL, t);
  if (back(armR)) drawArm(ctx, ch, 1, armR, t);
  drawLegs(ctx, ch, f);
  // far arm behind the torso when turned
  const farSide = -f.sg, nearSide = f.sg; const farPose = farSide < 0 ? armL : armR, nearPose = nearSide < 0 ? armL : armR;
  const stance = o.stance ?? f.sg * (ch.build === 'stout' ? .05 : .095);               // shoulder line tilt + hip shift (contrapposto)
  ctx.save(); ctx.translate(0, -3.0); ctx.rotate(stance); ctx.translate(0, 3.0);
  ctx.translate(0, -6); ctx.transform(1, 0, -f.sg * .03, 1, 0, 0); ctx.translate(0, 6);
  if (!back(farPose) && f.a > .25) drawArm(ctx, ch, farSide, farPose, t);
  cel(ctx, p => torsoPath(p, ch), ch.robe, { sd: .8, sv: .2, rd: .07, shadow: shade(ch.robe, .82) });
  costume(ctx, ch, f);
  // head group (cocked)
  ctx.save(); ctx.translate(f.sg * .08, CHIN - .1); ctx.rotate((o.tilt ?? f.sg * 13) * Math.PI / 180); ctx.translate(0, -(CHIN - .1));
  drawHairBack(ctx, ch, f);
  const skin = ch.skin || SKIN4;
  cel(ctx, headPath, skin, { sd: .5, rd: .07, shadow: shade(skin, .86), rim: SKIN4_RIM });
  // tiny nose bump on the facing silhouette (3/4 only)
  drawHairFront(ctx, ch, f);
  drawBeard(ctx, ch, f);
  const blink = o.blink !== false && ((t + (o.blinkPhase || 0)) % 3.7) < .1;
  const ek = o.eyes || 'sleepy', bk = o.brows || (ek === 'angry' ? 'angry' : ek === 'worried' ? 'worried' : ek === 'shock' ? 'shock' : ek === 'squint' ? 'squint' : 'dash');
  const EK = ch.eyeK || 1; drawEye(ctx, ek, f.near[0], f.near[1], EK, f.sg, 1, blink, t); drawEye(ctx, ek, f.far[0], f.far[1], f.farK * EK, f.sg, -1, blink, t);
  drawBrow(ctx, bk, f.near[0], f.near[1], EK, f.sg, 1); drawBrow(ctx, bk, f.far[0], f.far[1], f.farK * EK, f.sg, -1);
  const fullBeard = ch.beard === 'full' || ch.beard === 'short';
  drawMouth(ctx, o.mouth || (fullBeard ? 'closed' : 'neutral'), o.talk, t, f.mouth[0], f.mouth[1], f.sg);
  drawHat(ctx, ch, f, t);
  if (o.sweat) { ctx.save(); const k = (t * 1.2) % 1; ctx.translate(-f.sg * 1.05, HY - .5 + k * .5); cel(ctx, c => { c.moveTo(0, -.3); c.quadraticCurveTo(.22, .02, 0, .14); c.quadraticCurveTo(-.22, .02, 0, -.3); }, '#9ED6F2', { sd: .05, rd: .03, lw: LW_I }); ctx.restore(); }
  ctx.restore();
  if (!back(nearPose)) drawArm(ctx, ch, nearSide, nearPose, t);
  if (!back(farPose) && f.a <= .25) drawArm(ctx, ch, farSide, farPose, t);
  ctx.restore();
  ctx.restore();
}
function handAt(ctx, x, y, type, rot, s, flip) { ctx.save(); ctx.translate(x, y); ctx.scale(s, s); ctx.rotate(rot); drawMitten(ctx, type, flip); ctx.restore(); }

// ---------- cast (fixed for the series), muted earthy palette ----------
const CAST = {
  RANIERI: { name: 'Consul Ranieri', build: 'stout', long: true, skin: '#C0BCC1', robe: '#6E2E37', sleeve: '#652A33', trim: '#C29E50', hat: 'chaperon', hatColor: '#9C3F3B', hair: 'short', hairColor: '#7F7974', hairLen: .5, beard: 'goatee', beardColor: '#4E4743', fur: '#C4B190', chain: true, shoes: '#2d2020' },
  GHERARDO: { name: 'Mastro Gherardo', build: 'normal', headHH: 1.3, robe: '#86704F', sleeve: '#7A6547', rolled: true, neck: 'v', hat: 'felt', hatColor: '#4A3C30', hair: 'curly', hairColor: '#2B211B', hairLen: .35, beard: 'full', beardColor: '#1E1714', skin: '#B5B1B6', apron: '#5B4431', belt: '#382A1F', legs: '#57514A', shoes: '#3b2a20' },
  WORKER: { name: 'Worker', build: 'normal', headHH: 1.12, eyeK: 1.15, robe: '#5B6A4C', sleeve: '#536245', rolled: true, neck: 'v', hat: 'band', hatColor: '#B39C76', hair: 'curly', hairColor: '#2E2620', hairLen: .45, belt: '#382A1F', legs: '#4A4F5E', shoes: '#3b2a20' },
};
