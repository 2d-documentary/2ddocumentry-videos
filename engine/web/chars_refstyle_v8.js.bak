    const by = hy(.2), bw = headW(.2, 1) + .12;
    cel(ctx, p => { p.moveTo(-bw + o * .5, by); p.bezierCurveTo(-bw - .02 + o, HEAD_TOP - .5, bw + .02 + o, HEAD_TOP - .5, bw + o * .5, by); p.quadraticCurveTo(o, by - .22, -bw + o * .5, by); p.closePath(); }, c, { sd: .3, rd: .05 });
    cel(ctx, p => { p.moveTo(-bw - .06, by - .06); p.quadraticCurveTo(o, by - .36, bw + .06, by - .06); p.quadraticCurveTo(bw + .08, by + .14, bw - .02, by + .16); p.quadraticCurveTo(o, by - .1, -bw + .02, by + .16); p.quadraticCurveTo(-bw - .08, by + .14, -bw - .06, by - .06); p.closePath(); }, shade(c, .85), { sd: .12, rd: .03 });
