function drawHairFront(ctx, ch, f) {
  if (!ch.hair || ch.hat === 'felt' || ch.hat === 'chaperon') return; const c = ch.hairColor, o = f.cx * .5, top = HEAD_TOP;
  ctx.save(); ctx.beginPath(); headPath(ctx); ctx.clip();
