  if (!ch.long) for (const [sx, ang] of LEG) {
    ctx.save(); ctx.translate(sx, -3.0); ctx.rotate(ang); ctx.translate(-sx, 3.0);
    const path = p => { p.moveTo(sx - .37, -3.0); p.quadraticCurveTo(sx - .42, -1.6, sx - .25, -.42); p.lineTo(sx + .25, -.42); p.quadraticCurveTo(sx + .42, -1.6, sx + .37, -3.0); p.closePath(); };
