}

// ---------- arms: one soft noodle each, big mitten hands ----------
const ARMS = {
  down: { a1: 9, a2: -6, hand: 'fist' }, belt: { a1: 14, a2: -62, hand: 'thumbBelt', k2: .62 }, open: { a1: 10, a2: 6, hand: 'open', handRot: 20 }, hip: { a1: 52, a2: -122, hand: 'fist', k2: .72 },
  behind: { a1: 14, a2: -38, hand: 'none', back: true }, point: { a1: 86, a2: 6, hand: 'point' }, pointUp: { a1: 150, a2: 15, hand: 'point' },
  raise: { a1: 140, a2: 30, hand: 'open' }, palmUp: { a1: 26, a2: 66, hand: 'open', handRot: -75, k2: .85 }, thumb: { a1: 30, a2: 108, hand: 'thumb', k2: .85 },
  hold: { a1: -4, a2: -84, hand: 'fist', k2: .85 }, chin: { a1: -4, a2: -152, hand: 'fist', k2: 1.0 }, wave: { a1: 118, a2: 42, hand: 'open' },
  tool: { a1: 12, a2: 46, hand: 'fist', k2: .9, prop: 'mallet' }, shrug: { a1: 42, a2: 72, hand: 'open', handRot: -85, k2: .8 },
};
const AL1 = 1.75, AL2 = 1.55;
function armGeom(ch, side, A, t) {
  const wob = A.wob ? Math.sin(t * A.wob) * 8 : 0, d = Math.PI / 180;
  const a1 = (A.a1 + wob) * d, a2 = (A.a1 + A.a2 + wob * 1.4) * d;
