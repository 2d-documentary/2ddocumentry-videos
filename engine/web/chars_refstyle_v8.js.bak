    for (let i = tips.length - 1; i >= 0; i--) { const t = tips[i], prev = i === tips.length - 1 ? [1.2, hy(.22)] : tips[i + 1]; p.quadraticCurveTo((prev[0] + t[0]) / 2 + .04, Math.min(prev[1], t[1]) - .22, t[0], t[1]); }
    p.quadraticCurveTo(-1.0, hy(.1), -1.25, hy(.18)); p.closePath(); }, c, { sd: .14, rd: 0, shadow: shade(c, .7),
    after: k => { k.beginPath(); k.ellipse(-.35 + o, top + .28, .3, .09, -.25, 0, 7); k.fillStyle = mix(c, '#ffffff', .15); k.fill(); } });
  for (const [x0, x1] of [[-.2, -.3], [.3, .26]]) tstroke(ctx, [x0 + o, top + .2], [x0 + o + .06, hy(.1)], [x1 + o, hy(.22)], .03, shade(c, .5));
