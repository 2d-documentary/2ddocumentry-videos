  const R = {
    moveTo(x, y) { cur = { pts: [], closed: false }; subs.push(cur); push(x, y); },
    lineTo(x, y) { push(x, y); },
    quadraticCurveTo(cx, cy, x, y) { const [x0, y0] = last; for (let i = 1; i <= 8; i++) { const u = i / 8; push((1 - u) * (1 - u) * x0 + 2 * (1 - u) * u * cx + u * u * x, (1 - u) * (1 - u) * y0 + 2 * (1 - u) * u * cy + u * u * y); } },
    bezierCurveTo(c1x, c1y, c2x, c2y, x, y) { const [x0, y0] = last; for (let i = 1; i <= 12; i++) { const u = i / 12, v = 1 - u; push(v * v * v * x0 + 3 * v * v * u * c1x + 3 * v * u * u * c2x + u * u * u * x, v * v * v * y0 + 3 * v * v * u * c1y + 3 * v * u * u * c2y + u * u * u * y); } },
    ellipse(x, y, rx, ry, rot, a0, a1, ccw) { let d = a1 - a0; if (ccw && d > 0) d -= Math.PI * 2; if (!ccw && d < 0) d += Math.PI * 2; if (Math.abs(a1 - a0) >= Math.PI * 2 - 1e-6) d = ccw ? -Math.PI * 2 : Math.PI * 2; const n = Math.max(8, Math.ceil(Math.abs(d) / .2)); const cr = Math.cos(rot), sr = Math.sin(rot);
      for (let i = 0; i <= n; i++) { const a = a0 + d * i / n, ex = rx * Math.cos(a), ey = ry * Math.sin(a); const px = x + ex * cr - ey * sr, py = y + ex * sr + ey * cr; if (i === 0 && cur && cur.pts.length) push(px, py); else push(px, py); } },
    arc(x, y, r, a0, a1, ccw) { R.ellipse(x, y, r, r, 0, a0, a1, ccw); },
    rect(x, y, w, h) { R.moveTo(x, y); push(x + w, y); push(x + w, y + h); push(x, y + h); R.closePath(); },
    roundRect(x, y, w, h, r) { r = Math.min(r, w / 2, h / 2); R.moveTo(x + r, y); push(x + w - r, y); R.arc(x + w - r, y + r, r, -Math.PI / 2, 0); push(x + w, y + h - r); R.arc(x + w - r, y + h - r, r, 0, Math.PI / 2); push(x + r, y + h); R.arc(x + r, y + h - r, r, Math.PI / 2, Math.PI); push(x, y + r); R.arc(x + r, y + r, r, Math.PI, Math.PI * 1.5); R.closePath(); },
