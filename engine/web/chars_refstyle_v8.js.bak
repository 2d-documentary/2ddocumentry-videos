// ---------- body ----------
const SKIN4 = '#C9C6CB', SKIN4_SH = '#A9A5AD', SKIN4_RIM = '#E7E5E9';
function torsoPath(p, ch) {
  const st = ch.build === 'stout', robe = !!ch.long;
  const sh = st ? 1.3 : 1.18, wa = st ? 1.5 : 1.08, hip = st ? 1.58 : 1.3, hem = robe ? (st ? 1.55 : 1.3) : 1.24;
